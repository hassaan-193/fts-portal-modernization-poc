APP_NAME="FTS Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fts_portal
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
TELESCOPE_ENABLED=false

# Mail: "log" writes emails to storage/logs instead of sending them.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Accounts mailer (invoice emails)
ACCOUNTS_MAIL_HOST=
ACCOUNTS_MAIL_PORT=465
ACCOUNTS_MAIL_USERNAME=
ACCOUNTS_MAIL_PASSWORD=
ACCOUNTS_MAIL_ENCRYPTION=ssl
ACCOUNTS_MAIL_FROM_ADDRESS=accounts@example.com
ACCOUNTS_MAIL_FROM_NAME="Accounts"

# LPO outs mailer
LPOUTS_MAIL_HOST=
LPOUTS_MAIL_PORT=587
LPOUTS_MAIL_USERNAME=
LPOUTS_MAIL_PASSWORD=
LPOUTS_MAIL_ENCRYPTION=tls
LPOUTS_MAIL_FROM_ADDRESS=lpouts@example.com
LPOUTS_MAIL_FROM_NAME="LP Outs"

# QR attendance
OFFICE_LOCATION_NAME=MainOffice
OFFICE_LATITUDE=25.2048
OFFICE_LONGITUDE=55.2708
OFFICE_GEOFENCE_RADIUS_METERS=500
ATTENDANCE_GEOFENCE_ENABLED=false
QR_CODE_TOKEN=
ATTENDANCE_MONTHLY_RECIPIENTS=
ATTENDANCE_EXCLUDED_USER_IDS=

# WhatsApp notifications (StafProfile IDs, comma-separated)
WASENDER_API_KEY=
PO_REQUEST_NOTIFICATION_STAFF_IDS=
PO_NOTIFICATION_STAFF_IDS=
PO_ADMIN_NOTIFICATION_STAFF_IDS=
INQUIRY_NOTIFY_STAFF_IDS=
INQUIRY_NOTIFY_STAFF_IDS_AMC_ONLY=
QUOTATION_NOTIFY_SALES_STAFF_IDS=
INQUIRY_ALWAYS_NOTIFY_USER_IDS=
LEAVE_REQUEST_LABOR_NOTIFY_STAFF_IDS=
LEAVE_REQUEST_STAFF_NOTIFY_STAFF_IDS=

# Stripe (use your own test keys)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=aed
STRIPE_PUBLISHABLE_KEY_ABD=
STRIPE_PUBLISHABLE_KEY_RasAlkhaimah=

# Firebase service-account JSON path, relative to storage/app
FCM_CREDENTIALS=

# PDF generation (leave empty to use system wkhtmltopdf)
# WKHTMLTOPDF_PATH=
# WKHTMLTOIMAGE_PATH=
