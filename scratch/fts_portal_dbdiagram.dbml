  last_vacation_days int
  last_increment date
  last_increment_amount int
  basic_salary decimal [not null, default: '0']
  total_salary decimal [not null, default: '0']
  overtime_rate decimal [not null, default: '0']
  created_at timestamp
  updated_at timestamp
  mobile_no varchar
  home_mobile_no varchar
  exclude_from_expiry boolean [not null, default: '0']
}

Table staff_ratings {
  id bigint [pk, increment]
  staff_id int [not null]
  engineer_id bigint [not null]
  month int [not null]
  year int [not null]
  safety_compliance int [not null]
  communication int [not null]
  attendance int [not null]
  time_management int [not null]
  job_responsibility int [not null]
  material_handling int [not null]
  document_handling int [not null]
  competency int [not null]
  created_at timestamp
  updated_at timestamp
}

Table staff_requests {
  id int [pk, increment]
  staf_id int [not null]
  type varchar
  start_date date
  end_date date
  advance_money decimal
  device_type varchar
  letter_type varchar
  note text
  status boolean [not null, default: '0']
  created_at timestamp
  updated_at timestamp
}

Table tasks {
  id bigint [pk, increment]
  start_date datetime
  end_date datetime
  title varchar
  assigned bigint
  description varchar
  status boolean [default: '1']
  created_at timestamp
  updated_at timestamp
}

Table tickets {
  id bigint [pk, increment]
  staf_id int [not null]
  ticket_date date [not null]
  agent_name varchar [not null]
  travel_type varchar [not null]
  travel_date date [not null]
  return_date date
  amount decimal [not null]
  vat decimal [not null]
  total_value decimal [not null]
  payment_status varchar
  created_at timestamp
  updated_at timestamp
  updated_by bigint
}

Table transactions {
  id int [pk, increment]
  date_time timestamp [not null]
  type varchar [not null]
  transactionable_id int
  transactionable_type varchar
  expense_account int
  account_id int [not null]
  transaction_type int [not null]
  payment_type int [not null]
  payment_no varchar
  clearance_date varchar
  bank_name varchar
  vat decimal [not null]
  amount decimal [not null]
  total decimal [not null]
  note text
  from_account int
  status int [not null, default: '0']
  created_at timestamp
  updated_at timestamp
}

Table users {
  id bigint [pk, increment]
  name varchar
  email varchar [not null]
  email_verified_at timestamp
  password varchar [not null]
  image varchar
  remember_token varchar
  created_at timestamp
  updated_at timestamp
  firebase_token varchar
  api_token varchar
  staf_profile_id int
  balance decimal [not null]
  deleted_at timestamp
}

Table vendors {
  id int [pk, increment]
  name varchar [not null]
  email varchar
  emails text
  contact_person varchar
  contact_no varchar
  contact_no_two varchar
  vat_no varchar
  payment_terms varchar
  terms_and_conditions text
  credit_limit varchar
  location text
  file text
  payment_preference varchar [not null]
  pdc_number_of_days int
  pdc_payment_option varchar
  vendor_specialization varchar
  created_at timestamp
  updated_at timestamp
}

Table verify_emails {
  email varchar [not null]
  token varchar [not null]
  created_at timestamp
  updated_at timestamp
}

Table visit_schedule_comments {
  id bigint [pk, increment]
  visit_schedule_id bigint [not null]
  comment text [not null]
  created_at timestamp
  updated_at timestamp
}

Table visit_schedule_history {
  id bigint [pk, increment]
  project_id int [not null]
  visit_schedule_id bigint
  visit_date date
  status varchar [not null]
  company_name varchar [not null]
  project_name varchar [not null]
  created_at timestamp
  updated_at timestamp
}

Table visit_schedules {
  id bigint [pk, increment]
  project_id int [not null]
  visit_date date [not null]
  status varchar [not null, default: 'pending']
  file_uploaded boolean [not null, default: '0']
  file_path varchar
  created_at timestamp
  updated_at timestamp
}

