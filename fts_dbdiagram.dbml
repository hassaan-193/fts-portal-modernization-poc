  total_amount float [not null]
  is_advance int
  is_user_deduction int
  created_at timestamp
  updated_at timestamp
}

Table petty_cash_expenses [note: 'Accounting & Payments'] {
  id int [pk, increment, not null]
  name varchar(191) [not null]
  category varchar(191)
  amount float
  date date
  created_at timestamp
  updated_at timestamp
}

Table payrolls [note: 'Accounting & Payments'] {
  id int [pk, increment, not null]
  date date
  member_id int [not null, ref: > staf_profile.id]
  absents int
  hours float
  plus_adjustment float [not null, default: '0']
  minus_adjustment float [not null, default: '0']
  total_amount float [not null]
  note text
  created_at timestamp
  updated_at timestamp
}

// ────────────────────────────────────────────
// HR & STAFF
// ────────────────────────────────────────────

Table staf_profile [note: 'HR & Staff'] {
  id int [pk, increment, not null]
  name varchar(191)
  staf_type varchar(191)
  last_name varchar(191)
  nationality varchar(191)
  gender varchar(191)
  joining_date date
  dob date
  passport_expiry date
  visa_expiry date
  emirates_id_expiry date
  labor_card_expiry date
  driver_permit_expiry date
  last_vacation_start date
  last_vacation_end date
  last_vacation_days int
  last_increment date
  last_increment_amount int
  basic_salary float [not null, default: '0']
  total_salary float [not null, default: '0']
  overtime_rate float [not null, default: '0']
  created_at timestamp
  updated_at timestamp
  mobile_no varchar(191)
  home_mobile_no varchar(191)
  exclude_from_expiry boolean [not null, default: '0']
}

Table staf_dates [note: 'HR & Staff'] {
  id int [pk, increment, not null]
  staff_id int [not null]
  start_date date [not null]
  end_date date
  days int
  created_at timestamp
  updated_at timestamp
}

Table staff_requests [note: 'HR & Staff'] {
  id int [pk, increment, not null]
  staf_id int [not null, ref: > staf_profile.id]
  type varchar(191)
  start_date date
  end_date date
  advance_money float
  device_type varchar(191)
  letter_type varchar(191)
  note text
  status boolean [not null, default: '0']
  created_at timestamp
  updated_at timestamp
}

Table request_approvals [note: 'HR & Staff'] {
  id int [pk, increment, not null]
  request_type varchar(20) [not null]
  request_id int [not null]
  user_id int [not null]
  decision int [not null]
  note text
  decided_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table request_forms [note: 'HR & Staff'] {
  id int [pk, increment, not null]
  date_time timestamp [not null, default: 'current_timestamp()']
  user_id bigint [not null]
  name varchar(191) [not null]
  note text [not null]
  comments text
  status int [not null, default: '0']
  created_at timestamp
  updated_at timestamp
}

Table letters [note: 'HR & Staff'] {
  id bigint [pk, increment, not null]
  ref_no varchar(191)
  days_deduct int
  staff_profile_id int [not null, ref: > staf_profile.id]
  type enum('warning','appreciation','general_notice','poor_performance_notice','accommodation_notice','vehicle_notice','attendance_notice','weather_notice','eid_holidays_notice')
  title varchar(191) [not null]
  content text [not null]
  issued_by varchar(191) [not null]
  issued_at date [not null]
  created_at timestamp
  updated_at timestamp
}

Table monthly_staff_reports [note: 'HR & Staff'] {
  id bigint [pk, increment, not null]
  staff_id int [not null, ref: > staf_profile.id]
  month int [not null]
  year int [not null]
  safety_avg float [not null]
  communication_avg float [not null]
  attendance_avg float [not null]
  time_management_avg float [not null]
  job_responsibility_avg float [not null]
  material_handling_avg float [not null]
  document_handling_avg float [not null]
  competency_avg float [not null]
  final_score float [not null]
  created_at timestamp
  updated_at timestamp
}

Table staff_ratings [note: 'HR & Staff'] {
  id bigint [pk, increment, not null]
  staff_id int [not null, ref: > staf_profile.id]
  engineer_id bigint [not null, ref: > users.id]
  month int [not null]
  year int [not null]
  safety_compliance int [not null]
  communication int [not null]
  attendance int [not null]
  time_management int [not null]
  job_responsibility int [not null]
  material_handling int [not null]
  document_handling int [not null]
  competency int [not null]
  created_at timestamp
  updated_at timestamp
}

Table tickets [note: 'HR & Staff'] {
  id bigint [pk, increment, not null]
  staf_id int [not null, ref: > staf_profile.id]
  ticket_date date [not null]
  agent_name varchar(191) [not null]
  travel_type enum('one way','two way') [not null]
  travel_date date [not null]
  return_date date
  amount decimal(10,2) [not null]
  vat decimal(10,2) [not null]
  total_value decimal(10,2) [not null]
  payment_status varchar(191)
  created_at timestamp
  updated_at timestamp
  updated_by bigint
}

Table employees [note: 'HR & Staff'] {
  id int [pk, increment, not null]
  name varchar(191) [not null]
  email varchar(191)
  code varchar(191)
  contact_no varchar(191)
  balance float [not null, default: '0']
  created_at timestamp
  updated_at timestamp
}

Table labor_requests [note: 'HR & Staff'] {
  id int [pk, increment, not null]
  labor_id int [not null, ref: > employees.id]
  type varchar(191)
  start_date date
  end_date date
  advance_money float
  note text
  status boolean [not null, default: '0']
  created_at timestamp
  updated_at timestamp
}

Table labour_assignments [note: 'HR & Staff'] {
  id bigint [pk, increment, not null]
  labor_id int [not null, ref: > employees.id]
  project_id int [not null, ref: > projects.id]
  visit_schedule_id bigint [ref: > visit_schedules.id]
  assignment_start_date date
  assignment_end_date date
  created_at timestamp
  updated_at timestamp
  hours_worked int
  overtime_hours int [not null, default: '0']
}

// ────────────────────────────────────────────
// ATTENDANCE & SITES
// ────────────────────────────────────────────

Table sites [note: 'Attendance & Sites'] {
  id bigint [pk, increment, not null]
  site_name varchar(191) [not null]
  engineer_id bigint [not null, ref: > users.id]
  created_at timestamp
  updated_at timestamp
}

Table attendances [note: 'Attendance & Sites'] {
  id bigint [pk, increment, not null]
  labor_id int
  foreman_id bigint [not null]
  approved_by bigint [ref: > users.id]
  attendance_date date [not null]
  status enum('pending','approved','rejected') [not null, default: 'pending']
  notes text
  marked_at timestamp
  approved_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table attendance_approvals [note: 'Attendance & Sites'] {
  id bigint [pk, increment, not null]
  attendance_id bigint [not null, ref: > attendances.id]
  approved_by bigint [not null, ref: > users.id]
  action enum('approved','rejected') [not null]
  informed enum('informed','uninformed')
  specific_reason varchar(191)
  reason text
  created_at timestamp
  updated_at timestamp
}

Table attendance_labor_details [note: 'Attendance & Sites'] {
  id bigint [pk, increment, not null]
  attendance_id bigint [not null, ref: > attendances.id]
  labor_id int [not null, ref: > employees.id]
  overtime_hours decimal(5,2) [not null, default: '0.00']
  site_id bigint
  custom_site_name varchar(191)
  created_at timestamp
  updated_at timestamp
}

Table attendance_sessions [note: 'Attendance & Sites'] {
  id bigint [pk, increment, not null]
  user_id bigint [not null, ref: > users.id]
  session_date date [not null]
  clock_in_time datetime [not null]
  clock_in_latitude decimal(10,8) [not null]
  clock_in_longitude decimal(11,8) [not null]
  clock_in_distance_meters decimal(8,2)
  clock_out_time datetime
  clock_out_latitude decimal(10,8)
  clock_out_longitude decimal(11,8)
  clock_out_distance_meters decimal(8,2)
  duration_minutes int
  shift_window enum('shift_1','shift_2') [not null]
  is_late boolean [not null, default: '0']
  work_mode enum('split_shift','continuous') [not null, default: 'split_shift']
  session_status enum('open','closed') [not null, default: 'open']
  notes text
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table qr_staff_attendances [note: 'Attendance & Sites'] {
  id bigint [pk, increment, not null]
  staff_id bigint [not null, ref: > staf_profile.id]
  scanned_by bigint [not null, ref: > users.id]
  site_id bigint
  custom_site_name varchar(191)
  attendance_date date [not null]
  check_in_time datetime [not null]
  check_out_time datetime
  duration_minutes int
  overtime_minutes int [not null, default: '0']
  shift_end_time time [not null, default: '17:00:00']
  status enum('checked_in','checked_out') [not null, default: 'checked_in']
  review_status enum('pending','approved','rejected') [not null, default: 'pending']
  reviewed_by bigint
  reviewed_at datetime
  review_notes text
  final_overtime_source enum('manual','qr','custom')
  final_overtime_minutes int
  finalized_by bigint
  finalized_at datetime
  final_decision_notes text
  notes text
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

// ────────────────────────────────────────────
// PLATFORM
// ────────────────────────────────────────────

Table media [note: 'Platform'] {
  id bigint [pk, increment, not null]
  model_type varchar(191) [not null]
  model_id bigint [not null]
  collection_name varchar(191) [not null]
  name varchar(191) [not null]
  file_name varchar(191) [not null]
  mime_type varchar(191)
  disk varchar(191) [not null]
  size bigint [not null]
  manipulations longtext [not null]
  custom_properties longtext [not null]
  responsive_images longtext [not null]
  order_column int
  created_at timestamp
  updated_at timestamp
}

Table notifications [note: 'Platform'] {
  id char [pk, not null]
  type varchar(191) [not null]
  notifiable_type varchar(191) [not null]
  notifiable_id bigint [not null]
  data text [not null]
  read_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table comments [note: 'Platform'] {
  id int [pk, increment, not null]
  commentable_id bigint [not null]
  commentable_type varchar(191) [not null]
  comments text [not null]
  status int [not null, default: '0']
  user_id int [not null]
  created_at timestamp
  updated_at timestamp
}

Table device_tokens [note: 'Platform'] {
  id int [pk, increment, not null]
  user_id bigint [not null, ref: > users.id]
  token varchar(512) [not null]
  platform varchar(20) [not null, default: 'android']
  device_name varchar(191)
  last_used_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table lookups [note: 'Platform'] {
  id bigint [pk, increment, not null]
  name varchar(191) [not null]
  tag varchar(191) [not null]
  created_at timestamp
  updated_at timestamp
}

Table documents [note: 'Platform'] {
  id bigint [pk, increment, not null]
  name varchar(191) [not null]
  type varchar(191) [not null]
  date date
  created_at timestamp
  updated_at timestamp
}

Table tasks [note: 'Platform'] {
  id bigint [pk, increment, not null]
  start_date datetime
  end_date datetime
  title varchar(191)
  assigned bigint
  description varchar(191)
  status boolean [default: '1']
  created_at timestamp
  updated_at timestamp
}

Table failed_jobs [note: 'Platform'] {
  id bigint [pk, increment, not null]
  connection text [not null]
  queue text [not null]
  payload longtext [not null]
  exception longtext [not null]
  failed_at timestamp [not null, default: 'current_timestamp()']
}

// ────────────────────────────────────────────
// SYSTEM / OTHER TABLES
// ────────────────────────────────────────────

Table migrations {
  id int [pk, not null]
  migration varchar(191) [not null]
  batch int [not null]
}


